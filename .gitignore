# Build artifacts
.rebuild*/
.tmp*/
.tmp_patch/

# Large binary / tool directories (re-downloadable)
unity/
tools/
ghidra/
ghidra_work/
.ghidra-work/
*.gpr
*.rep
# `il2cpp/*` alone excludes the DIRECTORIES, so git never descends into them and
# the negation below can never match - v171.0.00's lib only ships because it was
# tracked before this rule existed. Re-include the dirs, exclude their contents,
# then let the LFS-tracked _ssl libs back in.
il2cpp/*
!il2cpp/*/
il2cpp/*/*
!il2cpp/*/libil2cpp_v*_ssl.so
frida/
xml_history/
# Admin panel build artifacts (reinstall with pnpm install)
server/admin/node_modules/
server/admin/.next/

# APK and archive files
apk/
KingBugCastle_share/
KingBugCastle_share.zip
.deploy/
*.apk
*.aab
*.xapk

# Redroid data (permission denied + large)
redroid-data/

# Python
__pycache__/
*.pyc
.venv/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
/tmp/

# Scratchpad temp/binary (re-generatable)
scratchpad/original_apk/
scratchpad/arm64_dump/
scratchpad/arm64_dump_out/
scratchpad/xml_repack_test/
scratchpad/mitm_capture/
scratchpad/*.png
scratchpad/*.tgz
scratchpad/gadget.so
scratchpad/fs
scratchpad/inject_gadget.py
scratchpad/revert_gadget.py
scratch/

# Native build output (source .cpp/.mk committed; objects/libs regenerated by cmake/ndk-build)
server/obj/
server/libs/
server/jni/obj/
server/jni/libs/
/tmp/stub_build/

# CDN manifest scratch backups (pristine xml.bak kept; these are throwaway)
server/real_cdn/ANDROID.bak*

# TLS certs + signing key (generated per-clone by setup.py; never ship a private key)
server/cert.pem
server/key.pem
server/certs/
.debug.keystore

# AI tool caches
.fallow/
.claude/
.codegraph/

# OCI SSH keys (never publish; oracle/ holds the server rescue keys)
oracle/

# Editor/IDE config
.obsidian/
.cursor/
opencode.jsonc
.mcp.json

# Training / Personal data
documentation/
reports/

# player state (SQLite WAL + lock); JSON files below are the pre-migration backup
server/state/players.db-wal
server/state/players.db-shm
server/state/.write.lock

# Agentmemory runtime store (state_store.db + stream_store, binary; not KGC project data)
/data/

# Live player save (runtime state; WAL/shm/lock already ignored above)
server/state/players.db
server/state/pre-sqlite-backup/
# ...and the automatic rotations of it. players.db itself was ignored but this
# directory was not, so KGC_BACKUP_HOURS quietly staged real player saves for
# commit - names, castle names, currency, the lot.
server/state/backups/

# Refused build path — emulator/anti-cheat bypass, never distribute
server/build_v171_emulator.py

# Project scratch + legacy JSON saves (runtime state, superseded by players.db)
scratchpad/
server/state/player.json
server/state/players/

# Anything genuinely secret goes in server/secrets/ and never in git. Ignore the
# CONTENTS rather than the directory, so a new secret dropped in there is covered
# without anyone remembering to add a rule - while the README explaining the
# convention still ships. `server/secrets/` on its own would exclude the directory,
# git would never descend into it, and the negation below could never match.
server/secrets/*
!server/secrets/README.md
# Belt and braces for the common shapes, wherever they land. Google hands its OAuth
# client out as a downloaded .json; one `git add .` away from being published, and
# the secret in it authorises token exchange as us.
*oauth*.json
*client_secret*.json
.env
.env.*
server/state/*.bak

# Agent planning notes (AI-generated scratch, not source)
plans/

# Python
.pytest_cache/
