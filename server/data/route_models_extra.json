  "/ranking/clan-point-ranking":          {"response": "ClanPointRankingResponseModel", "_method": "GetClanPointRanking"},
  "/ranking/colosseum-hall-of-fame":      {"response": "ColosseumRankingResponseModel", "_method": "GetColosseumHallOfFame"},
  "/ranking/colosseum-league-ranking":    {"response": "LeagueRankingResponseModel", "_method": "GetColosseumLeagueRanking"},
  "/ranking/colosseum-ranking":           {"response": "ColosseumRankingResponseModel", "_method": "GetColosseumRanking"},
  "/ranking/dimension-rift-ranking":      {"response": "RogueLikeRankingResponseModel", "_method": "GetDimensionRiftRanking"},
  "/ranking/pvp-hall-of-fame":            {"response": "PvPRankingResponseModel", "_method": "GetPvPHallOfFame"},
