{
  "_comment": [
    "Response models for client routes that generated/route_models.json misses.",
    "route_models.json is produced by pipeline/map_routes.py, which pairs a route",
    "string with a RestAPI method by name similarity and drops anything it cannot",
    "score confidently. 70 real v171 routes fell through that way and were answered",
    "with a bare ResponseModel - shape-valid but missing every field the client",
    "reads, which is how an empty ranking screen and a dead flag inventory looked",
    "like 'the feature is not implemented' rather than 'the response is the wrong",
    "type'. Each entry below is hand-mapped to the RestAPI method named in _method",
    "(see generated/restapi.json). server.py merges this over route_models.json.",
    "Run route_coverage.py after editing."
  ],

  "/accessory/equip":                     {"response": "AccessoryInventoryResponseModel", "_method": "FetchPlayerAccessory"},
  "/api/cloud-run/default-ranking":       {"response": "ServerListResponse", "_method": "GetDefaultInfraRankingServer"},
  "/api/cloud-run/services":              {"response": "ServerListResponse", "_method": "GetDevServers"},
  "/artifact/reroll":                     {"response": "ArtifactResultResponseModel", "_method": "ArtifactReroll"},
  "/auth":                                {"response": "AuthResponseModel", "_method": "Auth"},
  "/auth/usePatch":                       {"response": "ResponseModel", "_method": "CheckUsePatch"},
  "/babel":                               {"response": "BabelResponseModel", "_method": "FetchPlayerBabel"},
  "/card":                                {"response": "CardResponseModel", "_method": "GetCard"},

  "/clan/raid/deck-name":                 {"response": "ClanRaidDeckInfoResponseModel", "_method": "SetClanRaidDeckName"},
  "/clan/raid/delete-deck":               {"response": "ResponseModel", "_method": "SetClanRaidDeckPreset"},
  "/clan/support":                        {"response": "ClanRaidSupportResponseModel", "_method": "FetchClanRaidSupporters"},

  "/colosseum/check-end":                 {"response": "ColosseumEndGameReenterResponseModel", "_method": "CheckColosseumReenterEndGame"},
  "/colosseum/get-reward":                {"response": "RewardListResponseModel", "_method": "ColosseumGetReward"},
  "/colosseum/join-custom-match":         {"response": "ColosseumCustomMatchResponseModel", "_method": "JoinColosseumCustomMatch"},
  "/colosseum/open-mission-reward":       {"response": "RewardListResponseModel", "_method": "GetColosseumOpenMissionReward"},
  "/colosseum/record-minimum-rank":       {"response": "ResponseModel", "_method": "ColosseumRecordMinimumRank"},
  "/colosseum/reenter-succeed":           {"response": "ResponseModel", "_method": "ColosseumReenterSucceed"},
  "/colosseum/reenter-tried":             {"response": "ResponseModel", "_method": "ColosseumReenterTried"},
  "/colosseum/round-data":                {"response": "ResponseModel", "_method": "SaveColosseumRoundData"},
  "/colosseum/server-address":            {"response": "ColosseumMatchResponseModel", "_method": "FetchColosseumAddressByGameID"},
  "/colosseum/test-free-match":           {"response": "ColosseumMatchResponseModel", "_method": "TestColosseumFreeMatching"},

  "/dimension-unit/overcome":             {"response": "CardResponseModel", "_method": "(none - dimension hero overcome acts on a card)"},
  "/dimension-unit/upgrade":              {"response": "CardResponseModel", "_method": "(none - dimension hero upgrade acts on a card)"},

  "/event-card-collecting/gacha":         {"response": "EventCardGachaResponseModel", "_method": "EventCardGacha"},
  "/flag/equipedFlag":                    {"response": "FlagResponseModel", "_method": "FetchEquippedFlag"},
  "/flag/inventory":                      {"response": "FlagInventoryResponseModel", "_method": "FetchFlagInventory"},
  "/game/revive":                         {"response": "GameResponseModel", "_method": "GameRevive"},
  "/mission/check":                       {"response": "MissionResponseModel", "_method": "GetAllMissions"},
  "/mission/roguelike/check-on-clear":    {"response": "RogueLikeMissionResponseModel", "_method": "CheckRogueLikeMissionOnClear"},

  "/player/customEvent":                  {"response": "PlayerDataResponseModel", "_method": "CustomEvent"},
  "/player/early-access-mode-code":       {"response": "ResponseModel", "_method": "CheckEarlyAccessModeCode"},
  "/player/exception":                    {"response": "ResponseModel", "_method": "Exception"},
  "/player/get-login-scene-illust-data":  {"response": "LoginSceneIllustDataResponseModel", "_method": "GetLoginSceneIllustData"},
  "/player/logClickNotice":               {"response": "ResponseModel", "_method": "LogClickNotice"},
  "/player/other":                        {"response": "OtherPlayerDataResponseModel", "_method": "GetOtherPlayerInfo"},
  "/player/xcdReport":                    {"response": "AuthResponseModel", "_method": "XigncodeValidCheck"},
  "/player/year-event-buy-pass-point":    {"response": "YearEventBuyPassPointResponseModel", "_method": "BuyYearEventPassPoint"},

  "/ranking/ranking":                     {"response": "RankingResponseModel", "_method": "GetRanking"},
