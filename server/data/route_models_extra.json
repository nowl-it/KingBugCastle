  "/rogueLike/season-info":               {"response": "RogueLikeSeasonInfoResponseModel", "_method": "FetchRogueLikeSeasonInfo"},

  "/seasonal-event/april-fools/reward":   {"response": "RewardListResponseModel", "_method": "GetAprilFoolsReward"},
  "/shop/load-custom-pickups":            {"response": "CustomPickupsResponseModel", "_method": "LoadCustomPickups"},
  "/statistics/unit":                     {"response": "UnitStatisticsResponseModel", "_method": "GetUnitStatistics"},
  "/stock-event/prices":                  {"response": "StockEventPricesResponseModel", "_method": "GetStockPrices"},
  "/story-mode/challenge/daily-reward":   {"response": "ChallengeModeResponseModel", "_method": "(challenge daily reward shares the challenge model)"},

  "/territory-tycoon/collect-gold-token": {"response": "TerritoryTycoonTokenResponseModel", "_method": "TerritoryTycoonCollectGoldToken"},
  "/territory/collect-labor":             {"response": "TerritoryCollectLaborResponseModel", "_method": "TerritoryCollectLabor"},
  "/territory/remove-building":           {"response": "TerritoryCurrencyResponseModel", "_method": "RemoveTerritoryBuilding"},
  "/territory/store-building":            {"response": "ResponseModel", "_method": "StoreTerritoryBuilding"},
  "/territory/unstore-building":          {"response": "TerritoryBuildingResponseModel", "_method": "UnStoreTerritoryBuilding"},
  "/territory/upgrade-building":          {"response": "TerritoryBuildBuildingResponseModel", "_method": "UpgradeTerritoryBuilding"},
  "/territory/upgrade-building-immediately": {"response": "TerritoryBuildBuildingResponseModel", "_method": "UpgradeImmediatelyTerritoryBuilding"},

  "/test/roguelike/clear-count":          {"response": "ResponseModel", "_method": "UpdateRogueLikeClearCount"},
  "/test/roguelike/mission-clear-count":  {"response": "ResponseModel", "_method": "UpdateRogueLikeMissionClearCount"},
  "/test/roguelike/play-count":           {"response": "ResponseModel", "_method": "UpdateRogueLikePlayCount"},
  "/test/roguelike/reset-mission":        {"response": "ResponseModel", "_method": "ResetRogueLikeMission"},

  "/treasure/equip":                      {"response": "TreasureResultResponseModel", "_method": "TreasureEquip"}
}
