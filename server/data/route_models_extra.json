  "/ranking/roguelike-ranking":           {"response": "RogueLikeRankingResponseModel", "_method": "GetRogueLikeRanking"},

  "/rogueLike/can-revive-by-ad":          {"response": "ResponseModel", "_method": "RogueLikeCanReviveByAd"},
