[Unit]
Description=KGC coupon bot dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/kgc/server
EnvironmentFile=-/etc/kgc/coupon.env
ExecStart=/home/ubuntu/kgc/.venv/bin/uvicorn couponbot.web:app --host 127.0.0.1 --port 8083
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
